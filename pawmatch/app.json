{
  "expo": {
    "name": "PawMatch",
    "slug": "pawmatch",
    "scheme": "pawmatch",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "PawMatch צריכה גישה לתמונות כדי שתעלה תמונה שלך ושל חיית המחמד שלך."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7F3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawmatch.app"
    },
    "android": {
      "package": "com.pawmatch.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF7F3"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "icon": "./assets/icon.png"
  }
}
